# App Config
NEXT_PUBLIC_APP_NAME="shoppersite"
NEXT_PUBLIC_APP_DOMAIN="shopper.in"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# Dev OTP Guard (CRITICAL: When NODE_ENV=production, ALLOW_DEV_MOCK_OTP=true will crash startup)
ALLOW_DEV_MOCK_OTP="true"
DEV_MOCK_OTP="123456"

# Database (PostgreSQL with non-superuser app role for RLS)
DATABASE_URL="postgres://shopper_app_user:shopper_password@localhost:5432/shopper_db"

# SMS Provider (e.g. MSG91, Console Mock)
SMS_PROVIDER="mock"
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_DLT_TE_ID=""

# WhatsApp Business API
WHATSAPP_PROVIDER="mock"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Cloudflare R2 / Storage
STORAGE_PROVIDER="mock"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Razorpay (Platform's own subscriptions)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
